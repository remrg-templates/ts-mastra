{
	"name": "{{ remrg:var project-name }}",
	"version": "1.0.0",
	"description": "",
	"author": "{{ remrg:var organization }}",
	"license": "{{ remrg:var license }}",
	"scripts": {
		"start": "mastra start",
		"build": "mastra build && npm run build:instructions",
		"build:instructions": "npm run script build-instructions.ts",
		"dev": "mastra dev",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"lint": "eslint . --fix && prettier --write .",
		"lint:check": "prettier --check . && eslint .",
		"test": "npm run lint && npm run typecheck && npm run test:run",
		"test:ci": "npm run lint:check && npm run typecheck && npm run test:run",
		"test:dev": "vitest --ui --coverage",
		"test:run": "vitest run --coverage",
		"script": "tsx scripts"
	},
	"engines": {
		"node": ">=22.13.0",
		"npm": ">=10.8.2"
	},
	"dependencies": {
		"@mastra/core": "^1.60.0",
		"@mastra/duckdb": "^1.6.2",
		"@mastra/editor": "^0.14.0",
		"@mastra/libsql": "^1.21.0",
		"@mastra/memory": "^1.27.0",
		"@mastra/observability": "^1.17.1",
		"ts-appconfig": "^1.2.0",
		"ts-async-bootstrap": "^2.1.0",
		"ts-error-handler": "^1.0.2",
		"ts-tiny-log": "^1.1.1",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/node": "^22.19.17",
		"@typescript-eslint/eslint-plugin": "^8.57.2",
		"@typescript-eslint/parser": "^8.57.2",
		"@vitest/coverage-v8": "^4.1.2",
		"@vitest/ui": "^4.1.2",
		"cross-env": "^10.1.0",
		"eslint": "^10.1.0",
		"globals": "^17.6.0",
		"mastra": "^1.25.1",
		"prettier": "^3.8.1",
		"prettier-plugin-brace-style": "^0.10.1",
		"tsx": "^4.21.0",
		"typescript": "^6.0.3",
		"vitest": "^4.1.2"
	},
	"type": "module",
	"main": "index.js"
}
